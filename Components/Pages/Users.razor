@page "/users"
<PageTitle>Kullanıcılar</PageTitle>

<div class="page-head">
    <div>
        <h1>Kullanıcılar</h1>
        <p>SOME kullanıcı bilgileri.</p>
    </div>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger">@Error</div>
}

<div class="card">
    <div class="toolbar">
        <input @bind="Firstname" @bind:event="oninput" placeholder="İsim" />
        <input @bind="Lastname" @bind:event="oninput" placeholder="Soyad" />
        <input @bind="Email" @bind:event="oninput" placeholder="E-posta" />
        <input @bind="SomeId" @bind:event="oninput" placeholder="SOME No" />
        <button class="btn btn-light" @onclick="SearchAsync" disabled="@Busy">Filtrele</button>
        <button class="btn btn-light" @onclick="ClearAsync" disabled="@Busy">Temizle</button>
    </div>

    @if (Busy && Data is null)
    {
        <Loading Visible="true" Text="Kullanıcılar yükleniyor..." />
    }
    else if (Data is not null)
    {
        <div class="table-top-tools"><span class="muted">Toplam @Data.TotalCount kayıt</span><Pager Compact="true" Page="CurrentPage" TotalPages="@(Math.Max(Data.PageCount, 1))" TotalCount="@Data.TotalCount" Busy="Busy" PageChanged="GoToPageAsync" /></div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Ad Soyad</th><th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">E-posta</th><th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Ünvan</th><th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Rol</th><th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Durum</th><th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">SOME</th><th></th></tr></thead>
                <tbody>
                    @if (Data.Models.Count > 0)
                    {
                        @foreach (var item in Data.Models)
                        {
                            <tr class="@(item.Status == 1 ? "row-active" : "row-inactive")">
                                <td>@item.Firstname @item.Lastname</td>
                                <td>@item.Email</td>
                                <td>@item.UserTitle</td>
                                <td>@item.Role</td>
                                <td>@(item.Status switch { 0 => "Pasif", 1 => "Aktif", 2 => "Silinmiş", _ => item.Status.ToString() })</td>
                                <td>@item.SomeId</td>
                                <td><a class="btn btn-light btn-small" href="/users/@item.Id">Detay</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="muted">Kayıt bulunamadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Page="CurrentPage" TotalPages="@(Math.Max(Data.PageCount, 1))" TotalCount="@Data.TotalCount" Busy="Busy" PageChanged="GoToPageAsync" />
    }
</div>

@code {
    [Inject] private SipApiClient Api { get; set; } = default!;

    private ApiListData<UserInfo>? Data;
    private string? Error;
    private string? Firstname;
    private string? Lastname;
    private string? Email;
    private string? SomeId;
    private bool Busy;
    private bool loaded;
    private int CurrentPage = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !loaded)
        {
            loaded = true;
            await LoadAsync();
        }
    }

    private async Task SearchAsync() { CurrentPage = 1; await LoadAsync(); }

    private async Task ClearAsync()
    {
        Firstname = null;
        Lastname = null;
        Email = null;
        SomeId = null;
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1) return;
        if (Data is not null && Data.PageCount > 0 && page > Data.PageCount) return;
        CurrentPage = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            Data = await Api.GetListAsync<UserInfo>(
                "users",
                new Dictionary<string, string?>
                {
                    ["page"] = (CurrentPage - 1).ToString(),
                    ["per-page"] = "20",
                    ["firstname"] = Firstname,
                    ["lastname"] = Lastname,
                    ["email"] = Email,
                    ["some_id"] = SomeId
                });
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Busy = false; await InvokeAsync(StateHasChanged); }
    }
}
