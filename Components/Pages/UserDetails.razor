@page "/users/{Id:int}"
<PageTitle>Kullanıcı</PageTitle><div class="page-head"><div><h1>@Item?.Firstname @Item?.Lastname</h1><p>@Item?.Role</p></div><a class="btn btn-light" href="/users">← Geri</a></div>@if(Error is not null){<div class="alert alert-danger">@Error</div>}@if(Item is not null){<div class="card"><dl class="detail-grid"><dt>E-posta</dt><dd>@Item.Email</dd><dt>Ünvan</dt><dd>@Item.UserTitle</dd><dt>İş Telefonu</dt><dd>@Item.WorkPhone</dd><dt>Cep Telefonu</dt><dd>@Item.MobilePhone</dd><dt>SOME ID</dt><dd>@Item.SomeId</dd><dt>Oluşturulma</dt><dd>@Format.Unix(Item.CreatedAt)</dd></dl></div>}
@code{[Parameter]public int Id{get;set;}[Inject]private SipApiClient Api{get;set;}=default!;private UserInfo? Item;private string? Error;private bool loaded;protected override async Task OnParametersSetAsync(){if(loaded)return;loaded=true;try{Item=await Api.GetAsync<UserInfo>($"users/{Id}");}catch(Exception ex){Error=ex.Message;}}}
