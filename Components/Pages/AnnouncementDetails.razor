@page "/announcements/{Id:int}"
<PageTitle>Duyuru</PageTitle>
<div class="usom-modal-backdrop">
    <section class="usom-modal" role="dialog" aria-modal="true" aria-label="Duyuru Detayı">
        <button type="button" class="modal-close" data-modal-close @onclick="CloseModal" aria-label="Kapat" title="Kapat">×</button>

<div class="page-head"><div><h1>@Item?.Title</h1><p>@Item?.Code • @Format.Unix(Item?.CreatedAt ?? 0)</p></div><a class="btn btn-light" href="/announcements">← Geri</a></div>
@if(Error is not null){<div class="alert alert-danger">@Error</div>}@if(Item is not null){<div class="card"><div class="prose">@((MarkupString)HtmlContent.ToSafeHtml(Item.Content))</div>@if(Item.Files.Count>0){<hr/><h3>Ekler</h3>@foreach(var f in Item.Files){<div><a href="/api/files/announcements/@f.Id?name=@Uri.EscapeDataString(f.Name ?? ("ek-" + f.Id))">@f.Name</a></div>}}</div>}
    </section>
</div>
@code{[Parameter]public int Id{get;set;}[Parameter]public EventCallback OnClose{get;set;}[Inject]private SipApiClient Api{get;set;}=default!;[Inject]private NavigationManager Navigation{get;set;}=default!;private async Task CloseModal(){if(OnClose.HasDelegate)await OnClose.InvokeAsync();else Navigation.NavigateTo("/announcements");}private Announcement? Item;private string? Error;private bool loaded;protected override async Task OnParametersSetAsync(){if(loaded)return;loaded=true;try{Item=await Api.GetAsync<Announcement>($"announcements/{Id}");}catch(Exception ex){Error=ex.Message;}}}
