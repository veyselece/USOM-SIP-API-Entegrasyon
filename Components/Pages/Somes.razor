@page "/somes"
<PageTitle>SOME'ler</PageTitle>

<div class="page-head">
    <div>
        <h1>SOME'ler</h1>
        <p>USOM SİP platformundaki SOME bilgileri.</p>
    </div>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger">@Error</div>
}

<div class="card">
    <div class="toolbar">
        <input @bind="Name" @bind:event="oninput" placeholder="SOME ismi" />
        <input @bind="Email" @bind:event="oninput" placeholder="E-posta" />
        <select @bind="Status">
            <option value="">Tüm durumlar</option>
            <option value="0">Pasif</option>
            <option value="1">Aktif</option>
        </select>
        <button class="btn btn-light" @onclick="SearchAsync" disabled="@Busy">Filtrele</button>
        <button class="btn btn-light" @onclick="ClearAsync" disabled="@Busy">Temizle</button>
        <button class="btn btn-light" @onclick="LoadAsync" disabled="@Busy">↻ Yenile</button>
    </div>

    @if (Busy && Data is null)
    {
        <Loading Visible="true" Text="SOME kayıtları yükleniyor..." />
    }
    else if (Data is not null)
    {
        <div class="table-top-tools"><span class="muted">Toplam @Data.TotalCount kayıt</span><Pager Compact="true" Page="CurrentPage" TotalPages="@(Math.Max(Data.PageCount, 1))" TotalCount="@Data.TotalCount" Busy="Busy" PageChanged="GoToPageAsync" /></div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>İsim</th><th>E-posta</th><th>Adres</th><th>Telefon</th><th>Durum</th><th></th></tr></thead>
                <tbody>
                    @if (Data.Models.Count > 0)
                    {
                        @foreach (var item in Data.Models)
                        {
                            <tr>
                                <td><strong>@item.Name</strong></td>
                                <td>@item.Email</td>
                                <td>@item.Address</td>
                                <td>@item.LandPhone</td>
                                <td>@(item.Status == 1 ? "Aktif" : "Pasif")</td>
                                <td><a class="btn btn-light btn-small" href="/somes/@item.Id">Detay</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="muted">Kayıt bulunamadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Page="CurrentPage" TotalPages="@(Math.Max(Data.PageCount, 1))" TotalCount="@Data.TotalCount" Busy="Busy" PageChanged="GoToPageAsync" />
    }
</div>

@code {
    [Inject] private SipApiClient Api { get; set; } = default!;

    private ApiListData<SomeInfo>? Data;
    private string? Error;
    private string? Name;
    private string? Email;
    private string? Status;
    private bool Busy;
    private bool loaded;
    private int CurrentPage = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !loaded)
        {
            loaded = true;
            await LoadAsync();
        }
    }

    private async Task SearchAsync() { CurrentPage = 1; await LoadAsync(); }

    private async Task ClearAsync()
    {
        Name = null;
        Email = null;
        Status = null;
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1) return;
        if (Data is not null && Data.PageCount > 0 && page > Data.PageCount) return;
        CurrentPage = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            Data = await Api.GetListAsync<SomeInfo>(
                "somes",
                new Dictionary<string, string?>
                {
                    ["page"] = (CurrentPage - 1).ToString(),
                    ["per-page"] = "20",
                    ["name"] = Name,
                    ["email"] = Email,
                    ["status"] = Status
                });
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Busy = false; await InvokeAsync(StateHasChanged); }
    }
}
