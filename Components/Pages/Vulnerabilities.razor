@page "/vulnerabilities"
<PageTitle>Gelen Siber Olaylar</PageTitle>

<div class="page-head">
    <div>
        <h1>Gelen Siber Olaylar</h1>
        <p>USOM tarafından kurumunuza bildirilen siber olaylar / zafiyetler.</p>
    </div>
    <div class="head-side"><div class="status-summary"><button type="button" class="status-badge badge-gray" @onclick="() => FilterByStatusAsync(null)">Tümü <b>@DisplayCount(TotalCount)</b></button><button type="button" class="status-badge badge-blue" @onclick='() => FilterByStatusAsync("1")'>Bildirildi <b>@DisplayCount(ReportedCount)</b></button><button type="button" class="status-badge badge-sky" @onclick='() => FilterByStatusAsync("2")'>Okundu <b>@DisplayCount(ReadCount)</b></button><button type="button" class="status-badge badge-amber" @onclick='() => FilterByStatusAsync("3")'>İşlem Yapılıyor <b>@DisplayCount(ProcessingCount)</b></button><button type="button" class="status-badge badge-green" @onclick='() => FilterByStatusAsync("4")'>Çözüldü <b>@DisplayCount(ResolvedCount)</b></button><button type="button" class="status-badge badge-gray" @onclick='() => FilterByStatusAsync("5")'>Kapatıldı <b>@DisplayCount(ClosedCount)</b></button></div></div>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger">@Error</div>
}

<div class="card">
    <div class="toolbar">
        <input @bind="Code" @bind:event="oninput" placeholder="Kod" />
        <input @bind="Address" @bind:event="oninput" placeholder="Adres" />
        <select @bind="Status">
            <option value="">Tüm durumlar</option>
            <option value="1">Bildirildi</option>
            <option value="2">Okundu</option>
            <option value="3">İşlem Yapılıyor</option>
            <option value="4">Çözüldü</option>
            <option value="5">Kapatıldı</option>
        </select>
        <button class="btn btn-light" @onclick="SearchAsync" disabled="@IsLoading">Filtrele</button>
        <button class="btn btn-light" @onclick="ClearAsync" disabled="@IsLoading">Temizle</button>
    </div>

    @if (IsLoading && Data is null)
    {
        <Loading Visible="true" Text="Gelen siber olaylar yükleniyor..." />
    }
    else if (Data is not null)
    {
        <div class="table-top-tools"><span class="muted">Toplam @Data.TotalCount kayıt</span><Pager Compact="true" Page="CurrentPage" TotalPages="@(Math.Max(Data.PageCount, 1))" TotalCount="@Data.TotalCount" Busy="IsLoading" PageChanged="GoToPageAsync" /></div>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Kod</th>
                        <th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Tanım ve URL</th>
                        <th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Durum</th>
                        <th class="sortable-header" role="button" tabindex="0" title="Sıralamak için tıklayın">Oluşturulma</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Data.Models.Count > 0)
                    {
                        @foreach (var item in Data.Models)
                        {
                            <tr>
                                <td><strong>@item.Code</strong></td>
                                <td class="definition-url-cell">
                                    <div class="definition-text">@HtmlContent.ToPlainText(item.Description, 320)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Address))
                                    {
                                        <div class="url-text"><span>URL</span> @HtmlContent.ToPlainText(item.Address, 260)</div>
                                    }
                                </td>
                                <td><span class="badge @Format.BadgeClassVulnerability(item.Status)">@Format.StatusVulnerability(item.Status)</span></td>
                                <td>@Format.Unix(item.CreatedAt)</td>
                                <td><a class="btn btn-light btn-small" href="/vulnerabilities/@item.Id">Detay</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="muted">Kayıt bulunamadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Page="CurrentPage"
               TotalPages="@(Math.Max(Data.PageCount, 1))"
               TotalCount="@Data.TotalCount"
               Busy="IsLoading"
               PageChanged="GoToPageAsync" />
    }
</div>

@code {
    [Inject] private SipApiClient Api { get; set; } = default!;

    private ApiListData<Vulnerability>? Data;
    private string? Error;
    private bool IsLoading;
    private bool loaded;
    private int CurrentPage = 1;
    private string? Code;
    private string? Status;
    private string? Address;
    private int? TotalCount; private int? ReportedCount; private int? ReadCount; private int? ProcessingCount; private int? ResolvedCount; private int? ClosedCount;
    private static string DisplayCount(int? n) => n?.ToString("N0") ?? "…";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !loaded)
        {
            loaded = true;
            await LoadAsync();
        }
    }

    private async Task FilterByStatusAsync(string? status)
    {
        Status = status;
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        Code = null;
        Status = null;
        Address = null;
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1) return;
        if (Data is not null && Data.PageCount > 0 && page > Data.PageCount) return;
        CurrentPage = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Error = null;

        try
        {
            var countTasks = new[] { CountAsync(null), CountAsync("1"), CountAsync("2"), CountAsync("3"), CountAsync("4"), CountAsync("5") };
            Data = await Api.GetListAsync<Vulnerability>(
                "vulnerabilities",
                new Dictionary<string, string?>
                {
                    ["page"] = (CurrentPage - 1).ToString(),
                    ["per-page"] = "20",
                    ["code"] = Code,
                    ["status"] = Status,
                    ["address"] = Address
                });
            var counts = await Task.WhenAll(countTasks);
            TotalCount = counts[0]; ReportedCount = counts[1]; ReadCount = counts[2]; ProcessingCount = counts[3]; ResolvedCount = counts[4]; ClosedCount = counts[5];
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task<int> CountAsync(string? status)
    {
        var q = new Dictionary<string, string?> { ["page"] = "0", ["per-page"] = "1" };
        if (status is not null) q["status"] = status;
        return (await Api.GetListAsync<Vulnerability>("vulnerabilities", q)).TotalCount;
    }
    private static string FriendlyError(Exception ex) => ex.Message;

}
