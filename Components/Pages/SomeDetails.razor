@page "/somes/{Id:int}"
<PageTitle>SOME</PageTitle><div class="page-head"><div><h1>@Item?.Name</h1><p>SOME #@Item?.Id</p></div><a class="btn btn-light" href="/somes">← Geri</a></div>@if(Error is not null){<div class="alert alert-danger">@Error</div>}@if(Item is not null){<div class="card"><dl class="detail-grid"><dt>E-posta</dt><dd>@Item.Email</dd><dt>Adres</dt><dd>@Item.Address</dd><dt>Kurum Telefonu</dt><dd>@Item.LandPhone</dd><dt>Cep Telefonu</dt><dd>@Item.MobilePhone</dd><dt>Fax</dt><dd>@Item.Fax</dd><dt>Durum</dt><dd>@(Item.Status==1?"Aktif":"Pasif")</dd></dl></div>}
@code{[Parameter]public int Id{get;set;}[Inject]private SipApiClient Api{get;set;}=default!;private SomeInfo? Item;private string? Error;private bool loaded;protected override async Task OnParametersSetAsync(){if(loaded)return;loaded=true;try{Item=await Api.GetAsync<SomeInfo>($"somes/{Id}");}catch(Exception ex){Error=ex.Message;}}}
